<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Aphelion.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Input" Version="2.23.0" PrivateAssets="all"/>
        <PackageReference Include="Silk.NET.WebGPU" Version="2.23.0" PrivateAssets="all"/>
        <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" Version="2.23.0" PrivateAssets="all"/>
        <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
      <None Update="Assets\Shaders\shader.wgsl">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
</Project>
